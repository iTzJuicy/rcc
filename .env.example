# Local development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production: replace with the public URL of the deployed backend.
# VITE_API_BASE_URL=https://your-backend.example.com/api
# Set this to the canonical public domain in production.
VITE_SITE_URL=https://your-public-domain.example
# Used by Vercel's dynamic sitemap proxy (backend origin, without /api).
BACKEND_API_URL=https://your-backend.example.com

# Optional: Frontend Sentry DSN (gated by cookie consent)
VITE_SENTRY_DSN=
