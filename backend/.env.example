PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/rcc_infrastructure
JWT_SECRET=replace_with_a_secure_random_secret_in_production
FRONTEND_URL=https://your-frontend-domain.example
FRONTEND_URLS=
SITE_URL=https://your-public-domain.example
# Set to the trusted reverse-proxy hop count or explicit trusted proxy list.
# Keep at 1 for the current single-proxy deployment; adjust if the proxy topology changes.
TRUST_PROXY=1

# Initial Admin Credentials (use a unique real email and password of 16+ characters)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Cloudinary (Free tier credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP notifications (required to email new leads and customer confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ENQUIRY_NOTIFICATION_EMAIL=

# Monitoring (Optional)
SENTRY_DSN=
