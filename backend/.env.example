PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/rcc_infrastructure
JWT_SECRET=replace_with_a_secure_random_secret_in_production
FRONTEND_URL=https://rcc-ruddy.vercel.app

# Initial Admin Credentials (set in environment)
DEFAULT_ADMIN_EMAIL=admin@rcc.com
DEFAULT_ADMIN_PASSWORD=change_this_password_immediately

# Cloudinary (Free tier credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (SMTP configuration for instant lead alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RCC Infrastructure" <info@rccinfrastructure.com>
ADMIN_NOTIFICATION_EMAIL=admin@rcc.com

# Monitoring (Optional)
SENTRY_DSN=
